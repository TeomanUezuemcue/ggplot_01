) +
# Markierung des Basisindex
geom_hline(
yintercept = 1,
color = "black",
linewidth = 0.4
)
# Grafik anzeigen
wage_plot
# Wissenschaftliche Grafik Code
wage_plot <- ggplot(
wage_long,
aes(x = Year, y = Index, color = Country)
) +
geom_line(
linewidth = 1.25
) +
# Farben manuell
scale_color_manual(
values = c(
"Germany" = "#D5A800",
"EMU 20" = "#003399",
"France" = "#008C95",
"Italy" = "#008C5A",
"Spain" = "#A62639",
"Greece" = "#704080"
)
) +
labs(
x = "Year",
y = "Unit Labor Cost Index (1999 = 1)",
color = "Country"
) +
scale_x_continuous(
breaks = seq(1999, 2020, by = 1),
limits = c(1999, 2020)
) +
scale_y_continuous(
breaks = seq(0.9, 1.8, by = 0.1),
limits = c(0.9, 1.7)
) +
theme_minimal() +
theme(
plot.title = element_text(
size = 14,
face = "bold"
),
axis.title = element_text(size = 11),
axis.text = element_text(size = 10),
legend.title = element_text(size = 11),
legend.text = element_text(size = 10)
) +
# Markierung bestimmter Jahreszahlen im Plot
geom_vline(
xintercept = 2005,
linetype = "dashed",
color = "darkgreen"
) +
annotate(
"text",
x = 2005, y = Inf,
label = "Agenda 2010",
color = "darkgreen",
angle = 90,
vjust = 1.5,
hjust = 2
) +
# Markierung des Basisindex
geom_hline(
yintercept = 1,
color = "black",
linewidth = 0.4
)
# Grafik anzeigen
wage_plot
